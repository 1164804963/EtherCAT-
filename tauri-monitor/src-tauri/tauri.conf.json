{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EtherCAT 测试台",
  "version": "0.1.0",
  "identifier": "io.ethercatbench.monitor",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "EtherCAT 测试台", "width": 1240, "height": 860, "minWidth": 780, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
